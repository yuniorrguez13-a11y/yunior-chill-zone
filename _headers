# ── páginas y código: siempre frescos ──
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/*.js
  Cache-Control: public, max-age=0, must-revalidate
/*.css
  Cache-Control: public, max-age=0, must-revalidate

# ── arte: pesa 61 MB, cambia poco, y los sprites llevan ?v= propio ──
/art/*
  Cache-Control: public, max-age=604800

# ── PWA: el manifest puede cachearse un rato; sw.js ya cae en la regla js ──
/manifest.json
  Cache-Control: public, max-age=3600

# ── imagen de preview para enlaces compartidos ──
/preview.png
  Cache-Control: public, max-age=86400

# ── fuentes y favicon: esto no cambia nunca ──
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/favicon.png
  Cache-Control: public, max-age=2592000

# ── el piano carga un soundfont de 9 MB ──
/acoustic_piano.sf2
  Cache-Control: public, max-age=31536000, immutable
