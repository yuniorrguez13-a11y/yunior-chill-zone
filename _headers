# ═══════════════════════════════════════════════════════════════════
#  Cabeceras para Cloudflare
#
#  Reglas de caché pensadas para este sitio: el HTML y los scripts se
#  revalidan siempre (los cambios se ven al instante, se acabaron los
#  "refresca con Ctrl+Shift+R"), y el arte pesado se cachea de verdad
#  porque casi nunca cambia — y cuando cambia, los sprites ya viajan
#  con ?v= detrás, así que el navegador lo pilla igual.
# ═══════════════════════════════════════════════════════════════════

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# ── páginas y código: siempre frescos ──
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/*.js
  Cache-Control: public, max-age=0, must-revalidate
/*.css
  Cache-Control: public, max-age=0, must-revalidate

# ── arte: pesa 61 MB, cambia poco, y los sprites llevan ?v= propio ──
/art/*
  Cache-Control: public, max-age=604800

# ── fuentes y favicon: esto no cambia nunca ──
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/favicon.png
  Cache-Control: public, max-age=2592000

# ── el piano carga un soundfont de 9 MB ──
/acoustic_piano.sf2
  Cache-Control: public, max-age=31536000, immutable
