{
  // ═══════════════════════════════════════════════════════════════════
  //  Yuniors Chill Zone — configuración para Cloudflare Workers
  //
  //  El sitio es HTML puro: no hay nada que compilar. Esto solo le dice
  //  a Cloudflare "sirve la carpeta entera tal cual", y las reglas de
  //  caché salen del archivo _headers.
  //
  //  Qué NO se publica: lo que esté en .assetsignore
  // ═══════════════════════════════════════════════════════════════════
  "name": "yunior-chill-zone",
  "compatibility_date": "2026-08-17",
  "assets": {
    "directory": "./"
  },

  // El sitio se sirve solo desde yuniorschillzone.xyz. Esto apaga las
  // direcciones sueltas que Cloudflare regala (*.workers.dev y una URL
  // nueva por cada despliegue), que servían copias enteras del sitio en
  // dominios que no son el tuyo.
  "workers_dev": false,
  "preview_urls": false,

  // Los dominios que sirve este Worker. Escrito aquí para que sobreviva
  // a cualquier cambio en el panel: si alguien los desconecta a mano, el
  // siguiente despliegue los vuelve a poner.
  //
  // Ojo con el DNS: estos dos nombres no pueden tener registros A/AAAA/CNAME
  // propios en la zona, o Cloudflare rechaza el dominio con "already has
  // externally managed DNS records". Los cuatro A a 185.199.x.153 y el CNAME
  // de www que dejó GitHub Pages se borraron el 18 ago 2026 por esto mismo.
  // NO tocar el registro Tunnel de movies. (Jellyfin) ni nada de Zoho.
  "routes": [
    { "pattern": "yuniorschillzone.xyz", "custom_domain": true },
    { "pattern": "www.yuniorschillzone.xyz", "custom_domain": true }
  ]
}
